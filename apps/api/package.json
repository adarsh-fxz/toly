{
  "name": "@toly/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "admin:grant": "tsx --env-file-if-exists=../../.env src/scripts/grant-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.13",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@toly/db": "workspace:*",
    "@toly/shared": "workspace:*",
    "better-auth": "^1.7.13",
    "hono": "^4.13.14",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@toly/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
