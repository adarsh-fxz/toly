# Loaded by apps/api and packages/db from the repo root.

# Postgres (Neon or local docker compose)
DATABASE_URI=postgresql://toly:toly@localhost:5432/toly
# Optional locally; enables Redis-backed sessions, OTP storage and rate limits
REDIS_URL=redis://localhost:6379

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# openssl rand -base64 48
BETTER_AUTH_SECRET=

# Google OAuth (redirect URI: $WEB_URL/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile (optional; protects OTP sending)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS: console (dev) or sparrow
SMS_PROVIDER=console
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=
