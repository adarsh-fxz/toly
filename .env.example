# Loaded by apps/api, apps/web (next.config) and packages/db from the repo root.

# Postgres (Neon or `docker compose up -d` locally)
DATABASE_URI=postgresql://toly:toly@localhost:5432/toly
# Optional locally; enables Redis-backed sessions, OTP storage and rate limits
REDIS_URL=redis://localhost:6379

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Production only: the domain Caddy serves (deploy/Caddyfile)
TOLY_DOMAIN=

# openssl rand -base64 48
BETTER_AUTH_SECRET=

# Header the edge proxy overwrites with the real client IP (see deploy/Caddyfile)
CLIENT_IP_HEADER=x-real-ip

# Google OAuth (redirect URI: $WEB_URL/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile (optional; protects OTP sending)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS: console (dev) or sparrow
SMS_PROVIDER=console
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Toly Spin payments: mock (dev) or khalti
PAYMENTS_PROVIDER=mock
# Explicitly allow mock providers in a hosted demo (keep NODE_ENV=production).
# Use only with a separate database containing synthetic demo identities.
DEMO_MODE=false
KHALTI_SECRET_KEY=
# Sandbox: https://dev.khalti.com/api/v2  Production: https://khalti.com/api/v2
KHALTI_API_URL=https://dev.khalti.com/api/v2
